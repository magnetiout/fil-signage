SELF_HOSTED=true
HIDE_BILLING=true
DISABLE_REGISTRATION=true
DISABLE_HOMEPAGE=true
ST_HIDE_SPONSOR=true
OTA_ENABLED=false
NODE_ENV=production
BIND_HOST=127.0.0.1
PORT=18140
DATA_DIR=/var/lib/fil-signage
APP_URL=https://signage.example.com
TZ=Europe/Istanbul
MAX_FILE_SIZE=100MB
# JWT secret is generated once under DATA_DIR/certs with mode0600. Preserve it in backups.
